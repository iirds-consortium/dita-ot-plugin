                  <navtitle>author</navtitle>
                  <shortdesc>party role of the party that edited the referenced information unit </shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Author" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Creator">
               <topicmeta>
                  <navtitle>creator</navtitle>
                  <shortdesc>party role of the party from which an information unit originated</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Creator" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Inspector">
               <topicmeta>
                  <navtitle>inspector</navtitle>
                  <shortdesc>party role of the party that evaluates conformity with the requirements</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Inspector" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.Identity">
            <topicmeta>
               <navtitle>identity</navtitle>
               <shortdesc>complex identifier of a resource in an external system</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#Identity" appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.IdentityType">
            <topicmeta>
               <navtitle>identity type</navtitle>
               <shortdesc>distinguished set of identifiers that are assigned to an iiRDS identity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#IdentityType" appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.EuropeanArticleNumber">
               <topicmeta>
                  <navtitle>EAN</navtitle>
                  <shortdesc>identity type of the European article number according to ISO/IEC 15420</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#EuropeanArticleNumber"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ObjectInstanceURI">
               <topicmeta>
                  <navtitle>instance of object URI</navtitle>
                  <shortdesc>identity type of the globally unique URI for the product instance</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ObjectInstanceURI"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ObjectTypeURI">
               <topicmeta>
                  <navtitle>object URI  product type</navtitle>
                  <shortdesc>identity type of the globally unique URI of a product product type</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ObjectTypeURI"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.OrderCode">
               <topicmeta>
                  <navtitle>order code</navtitle>
                  <shortdesc>identity type of the manufacturer's unique procurement key</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#OrderCode" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ArticleCode">
               <topicmeta>
                  <navtitle>article code</navtitle>
                  <shortdesc>identity type of the manufacturer's reference number or other identifier for products or for parts of a product</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ArticleCode" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.SerialNumber">
               <topicmeta>
                  <navtitle>serial number</navtitle>
                  <shortdesc>identity type of the number used to identify an individual product instance</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#SerialNumber" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ProductType">
               <topicmeta>
                  <navtitle>product type</navtitle>
                  <shortdesc>identity type for products of the same series</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ProductType" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.GlobalTradeItemNumber">
               <topicmeta>
                  <navtitle>GTIN</navtitle>
                  <shortdesc>identity type of internationally coordinated, uniform and globally unique article number for products and services</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#GlobalTradeItemNumber"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.IdentityDomain">
            <topicmeta>
               <navtitle>identity domain</navtitle>
               <shortdesc>organizational origin of an identifier that is assigned to an iiRDS identity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#IdentityDomain" appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.ContentLifeCycleStatusValue">
            <topicmeta>
               <navtitle>value of the information unit lifecycle status</navtitle>
               <shortdesc>categorical denomination of the information unit life cycle stage</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ContentLifeCycleStatusValue"
                           appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.InPreparation">
               <topicmeta>
                  <navtitle>in preparation</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource is still being edited</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#InPreparation"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Approved">
               <topicmeta>
                  <navtitle>approved</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource is correct</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Approved" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Deleted">
               <topicmeta>
                  <navtitle>deleted</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource has been revoked</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Deleted" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Reviewed">
               <topicmeta>
                  <navtitle>reviewed</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource has been checked</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Reviewed" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Released">
               <topicmeta>
                  <navtitle>released</navtitle>
                  <shortdesc>content life cycle status value which indicates that the associated information of the resource has been approved and is ready for publishing</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Released" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.InReview">
               <topicmeta>
                  <navtitle>in review</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource is being checked for correctness</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#InReview" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Withdrawn">
               <topicmeta>
                  <navtitle>withdrawn</navtitle>
                  <shortdesc>content life cycle status value which indicates that an already released information of the resource is not valid anymore</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Withdrawn" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
      </subjectdef>
      <subjectdef keys="iirds.InformationObject">
         <topicmeta>
            <navtitle>information object</navtitle>
            <shortdesc>version- and language-independent abstraction of an information unit</shortdesc>
            <resourceid appid="http://iirds.tekom.de/iirds#InformationObject"
                        appname="class-iri"/>
         </topicmeta>
      </subjectdef>
   </subjectdef>
</subjectScheme>


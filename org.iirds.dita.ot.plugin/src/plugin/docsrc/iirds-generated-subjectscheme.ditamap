      <subjectdef keys="iirds.AdministrativeMetadata">
         <topicmeta>
            <navtitle>administrative metadata</navtitle>
            <shortdesc>information that allows the management of iiRDS resources</shortdesc>
            <resourceid appid="http://iirds.tekom.de/iirds#AdministrativeMetadata"
                        appname="class-iri"/>
         </topicmeta>
         <subjectdef keys="iirds.ExternalClassification">
            <topicmeta>
               <navtitle>external classification</navtitle>
               <shortdesc>External classification of an iiRDS domain entity. Each classification must be related to the classification domain within which it is unambiguous.</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ExternalClassification"
                           appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.ClassificationType">
            <topicmeta>
               <navtitle>classification type</navtitle>
               <shortdesc>type of an classification that is assigned to an iiRDS domain entity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ClassificationType"
                           appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.DCC">
               <topicmeta>
                  <navtitle>DCC identifier</navtitle>
                  <shortdesc>classification type that references a document classification in the document kind classification code (DCC, IEC 61355)</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#DCC" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.VDI2770">
               <topicmeta>
                  <navtitle>VDI2770:2018 identifier</navtitle>
                  <shortdesc>classification type that references a document classification according to VDI2770:2018</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#VDI2770" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.EclassIRDI">
               <topicmeta>
                  <navtitle>ECLASS IRDI</navtitle>
                  <shortdesc>classification type that references an ECLASS product classification by an international registration data identifier (IRDI) path</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#EclassIRDI" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.EclassCodedName">
               <topicmeta>
                  <navtitle>ECLASS Coded Name</navtitle>
                  <shortdesc>8-digit class code that references an ECLASS product classification</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#EclassCodedName"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.CDD">
               <topicmeta>
                  <navtitle>CDD identifier</navtitle>
                  <shortdesc>classification type that references a product classification in the Common Data Dictionary (CDD, IEC 61360)</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#CDD" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.ContentLifeCycleStatus">
            <topicmeta>
               <navtitle>information unit lifecycle status</navtitle>
               <shortdesc>stage of an information unit in the information development process</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ContentLifeCycleStatus"
                           appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.Party">
            <topicmeta>
               <navtitle>party</navtitle>
               <shortdesc>person, organization, or system</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#Party" appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.ClassificationDomain">
            <topicmeta>
               <navtitle>external classification domain</navtitle>
               <shortdesc>domain of an external classification that is assigned to an iiRDS entity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ClassificationDomain"
                           appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.PartyRole">
            <topicmeta>
               <navtitle>party role</navtitle>
               <shortdesc>responsibility of a person or organization</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#PartyRole" appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.Customer">
               <topicmeta>
                  <navtitle>customer</navtitle>
                  <shortdesc>party role of the party that purchases or receives a product</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Customer" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Contributor">
               <topicmeta>
                  <navtitle>contributor</navtitle>
                  <shortdesc>party role of the party that provides input to the making of an information unit</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Contributor" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Manufacturer">
               <topicmeta>
                  <navtitle>manufacturer</navtitle>
                  <shortdesc>party role of the party that designs or produces a product</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Manufacturer" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Supplier">
               <topicmeta>
                  <navtitle>supplier</navtitle>
                  <shortdesc>party role of the party that provides products</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Supplier" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.PerformedBy">
               <topicmeta>
                  <navtitle>performed by</navtitle>
                  <shortdesc>party role of the party that changes the content life cycle status</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#PerformedBy" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Author">

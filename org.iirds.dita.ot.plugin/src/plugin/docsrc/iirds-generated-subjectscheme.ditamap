<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE subjectScheme
  PUBLIC "-//OASIS//DTD DITA Subject Scheme Map//EN" "subjectScheme.dtd">
<subjectScheme xml:lang="en">
   <subjectdef>
      <topicmeta>
         <navtitle>iirdsDomainEntity</navtitle>
         <shortdesc>any resource within the iiRDS domain</shortdesc>
         <resourceid appid="http://iirds.tekom.de/iirds#iirdsDomainEntity"
                     appname="class-iri"/>
      </topicmeta>
   </subjectdef>
   <subjectdef keys="iirds.iirdsDomainEntity">
      <topicmeta>
         <navtitle>iirdsDomainEntity</navtitle>
         <shortdesc>any resource within the iiRDS domain</shortdesc>
         <resourceid appid="http://iirds.tekom.de/iirds#iirdsDomainEntity"
                     appname="class-iri"/>
      </topicmeta>
      <subjectdef keys="iirds.InformationType">
         <topicmeta>
            <navtitle>information type</navtitle>
            <shortdesc>characteristic of content</shortdesc>
            <resourceid appid="http://iirds.tekom.de/iirds#InformationType" appname="class-iri"/>
         </topicmeta>
         <subjectdef keys="iirds.InformationSubject">
            <topicmeta>
               <navtitle>information subject</navtitle>
               <shortdesc>thematical characteristic of content</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#InformationSubject"
                           appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.Collection">
               <topicmeta>
                  <navtitle>collection</navtitle>
                  <shortdesc>information subject that covers specific content in lists or overviews</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Collection" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirdsMch.ListOfLubricants">
                  <topicmeta>
                     <navtitle>list of lubricants</navtitle>
                     <shortdesc>information subject. Collection of lubricants required for working tasks described in specific information units. The information is usually assembled from different information units.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#ListOfLubricants"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.GenericCollection">
                  <topicmeta>
                     <navtitle>collection</navtitle>
                     <shortdesc>information subject covering specific content in lists or overviews</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericCollection"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.ListOfSpareParts">
                  <topicmeta>
                     <navtitle>list of spare parts</navtitle>
                     <shortdesc>information subject. Collection of spare parts required for working tasks described in specific information units. The information is usually assembled from different information units.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#ListOfSpareParts"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.ListOfTools">
                  <topicmeta>
                     <navtitle>list of tools</navtitle>
                     <shortdesc>information subject. Collection of tools required for working tasks described in specific information units. The information is usually assembled from different information units.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#ListOfTools"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.ListOfProtectiveEquipment">
                  <topicmeta>
                     <navtitle>list of protective equipment</navtitle>
                     <shortdesc>information subject. Collection of protective equipment required for working tasks described in specific information units. The information is usually assembled from different information units.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#ListOfProtectiveEquipment"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.MaintenancePlan">
                  <topicmeta>
                     <navtitle>maintenance plan</navtitle>
                     <shortdesc>maintenance plan. Collection of information required for scheduled maintenance. The information is usually assembled from different information units.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#MaintenancePlan"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.LubricationPlan">
                  <topicmeta>
                     <navtitle>lubrication plan</navtitle>
                     <shortdesc>information subject. A lubrication plan shows the lubrication points of a machine/component and the required lubricants. </shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#LubricationPlan"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.PartsList">
                  <topicmeta>
                     <navtitle>list of parts</navtitle>
                     <shortdesc>information subject. Collection of parts.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#PartsList"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.ListOfOperatingSupplies">
                  <topicmeta>
                     <navtitle>list of operating supplies</navtitle>
                     <shortdesc>information subject. Collection of operating supplies; the information is usually assembled from different information units.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#ListOfOperatingSupplies"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.TechnicalOverview">
               <topicmeta>
                  <navtitle>technical overview</navtitle>
                  <shortdesc>information subject that covers the technical structure of a product</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#TechnicalOverview"
                              appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.Symbol">
                  <topicmeta>
                     <navtitle>symbol</navtitle>
                     <shortdesc>information subject that covers an assembly of visual designations, together with their names or explanations of their meaning</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#Symbol" appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.CircuitDiagram">
                  <topicmeta>
                     <navtitle>circuit diagram</navtitle>
                     <shortdesc>typical representation of an electrical circuit in (electrical) technology.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#CircuitDiagram"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.FlowDiagram">
                  <topicmeta>
                     <navtitle>flow diagram</navtitle>
                     <shortdesc>typical representation of a technical process.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#FlowDiagram"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.OperatingElement">
                  <topicmeta>
                     <navtitle>control element</navtitle>
                     <shortdesc>information subject that covers interaction elements in user interface </shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#OperatingElement"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdSft.Architecture">
                  <topicmeta>
                     <navtitle>architecture</navtitle>
                     <shortdesc>technical structure of a software product or component.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/software#Architecture"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.HydraulicDiagram">
                  <topicmeta>
                     <navtitle>hydraulic diagram</navtitle>
                     <shortdesc>graphical representation of flows of liquids for control, regulating, driving and braking devices of vehicles, airplanes or devices, whose forces are generated or transmitted by the pressure of a liquid.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#HydraulicDiagram"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.GenericTechnicalOverview">
                  <topicmeta>
                     <navtitle>technical overview</navtitle>
                     <shortdesc>information subject that covers the technical structure of a product</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericTechnicalOverview"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.PneumaticDiagram">
                  <topicmeta>
                     <navtitle>pneumatic diagram</navtitle>
                     <shortdesc>information subject. Contains a technical diagram of a pneumatic system.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#PneumaticDiagram"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdSft.Interface">
                  <topicmeta>
                     <navtitle>interface</navtitle>
                     <shortdesc>information subject. Point of interaction between hardware and software or between software programs.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/software#Interface"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.Layout">
                  <topicmeta>
                     <navtitle>layout</navtitle>
                     <shortdesc>information subject. Describes the technical structure of the component/machine.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Layout"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.Conformity">
               <topicmeta>
                  <navtitle>conformity</navtitle>
                  <shortdesc>information subject that covers applicable standards or the fulfilment of a product requirement</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Conformity" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.DeclarationOfConformity">
                  <topicmeta>
                     <navtitle>declaration of conformity</navtitle>
                     <shortdesc>information subject covering an assurance that the product complies  with the EU Declaration of Conformity for CE marking</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#DeclarationOfConformity"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.GenericConformity">
                  <topicmeta>
                     <navtitle>conformity</navtitle>
                     <shortdesc>information subject covering applicable law, standards, or the fulfilment of a product requirement</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericConformity"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.TechnicalReport">
                  <topicmeta>
                     <navtitle>technical report</navtitle>
                     <shortdesc>information subject covering a report of product conformity with legislative or normative requirements</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#TechnicalReport"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.ApplicableStandards">
                  <topicmeta>
                     <navtitle>applicable standard</navtitle>
                     <shortdesc>information subject covering rules, guidelines, or definitions of product characteristics that need to comply with normative or legislative requirements</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#ApplicableStandards"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.RiskAssessment">
                  <topicmeta>
                     <navtitle>risk assessment</navtitle>
                     <shortdesc>information subject covering a process comprising a risk analysis and risk evaluation of the product or their result</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#RiskAssessment"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.Process">
               <topicmeta>
                  <navtitle>process</navtitle>
                  <shortdesc>information subject that covers structured activities carried out to achieve a specific goal</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Process" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.GenericProcess">
                  <topicmeta>
                     <navtitle>process</navtitle>
                     <shortdesc>information subject that covers structured activities which are carried out to achieve a specific goal</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericProcess"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.Functionality">
               <topicmeta>
                  <navtitle>functionality</navtitle>
                  <shortdesc>information subject that covers specific capabilities of the product</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Functionality" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.GenericFunctionality">
                  <topicmeta>
                     <navtitle>functionality</navtitle>
                     <shortdesc>information subject that covers specific capabilities of the product</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericFunctionality"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.TechnicalData">
               <topicmeta>
                  <navtitle>technical data</navtitle>
                  <shortdesc>information subject that covers qualitative and quantitative characteristics of technical objects</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#TechnicalData" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.GenericTechnicalData">
                  <topicmeta>
                     <navtitle>technical data</navtitle>
                     <shortdesc>information subject that covers qualitative and quantitative characteristics  of technical objects</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericTechnicalData"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdSft.SystemRequirement">
                  <topicmeta>
                     <navtitle>system requirement</navtitle>
                     <shortdesc>information subject. Describes the requirements that need to be fulfilled in order for a software to be installed and operated.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/software#SystemRequirement"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.Formality">
               <topicmeta>
                  <navtitle>formality</navtitle>
                  <shortdesc>information subject that covers contractually relevant elements</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Formality" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.ContactInformation">
                  <topicmeta>
                     <navtitle>contact information</navtitle>
                     <shortdesc>information subject that covers information on how to contact a party</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#ContactInformation"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.ProductIdentification">
                  <topicmeta>
                     <navtitle>product identification</navtitle>
                     <shortdesc>information subject that covers information on identity and characteristics of products</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#ProductIdentification"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.GenericFormality">
                  <topicmeta>
                     <navtitle>formality</navtitle>
                     <shortdesc>information subject that covers contractually relevant elements</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericFormality"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.ManufacturerInformation">
                  <topicmeta>
                     <navtitle>manufacturer information</navtitle>
                     <shortdesc>information subject that covers information on the manufacturer of the product</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#ManufacturerInformation"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.LicenceTerm">
                  <topicmeta>
                     <navtitle>license terms</navtitle>
                     <shortdesc>information subject that covers a legal contract between two parties wherein the property owner gives permission to another party to use its intellectual properties</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#LicenceTerm" appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.WarrantyConditions">
                  <topicmeta>
                     <navtitle>warranty conditions</navtitle>
                     <shortdesc>information subject that covers the specific terms of a promise given by a manufacturer or supplier to a purchaser to properly repair, replace or refund a faulty product</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#WarrantyConditions"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.ScopeOfDelivery">
                  <topicmeta>
                     <navtitle>scope of delivery</navtitle>
                     <shortdesc>information subject that covers all work, services, materials, completed products, and documentation that the supplier shall provide to the purchaser according to the purchase order</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#ScopeOfDelivery"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.LegalInformation">
                  <topicmeta>
                     <navtitle>legal information</navtitle>
                     <shortdesc>information subject that covers supplementary information referencing laws or regulations</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#LegalInformation"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.ProductName">
                  <topicmeta>
                     <navtitle>product name</navtitle>
                     <shortdesc>information subject that covers the designation of a product</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#ProductName" appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.Safety">
               <topicmeta>
                  <navtitle>safety</navtitle>
                  <shortdesc>information subject that covers content which helps to avoid risk</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Safety" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.ForeseeableMisuse">
                  <topicmeta>
                     <navtitle>foreseeable misuse</navtitle>
                     <shortdesc>information subject that covers the use of a product or system in a way not intended by the supplier, but which can result from readily predictable human behaviour</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#ForeseeableMisuse"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.IntendedUse">
                  <topicmeta>
                     <navtitle>intended use</navtitle>
                     <shortdesc>information subject that covers information which states the range of functions or foreseen applications defined and designed by the supplier of the product</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#IntendedUse" appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.SafetyEquipment">
                  <topicmeta>
                     <navtitle>safety equipment</navtitle>
                     <shortdesc>information subject. Describes equipment that is used for the protection of life and to avoid injuries or casualties.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#SafetyEquipment"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.EnvironmentalNote">
                  <topicmeta>
                     <navtitle>environmental note</navtitle>
                     <shortdesc>information subject. Notes in technical documentation regarding environmental protection.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#EnvironmentalNote"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.SafetyMeasure">
                  <topicmeta>
                     <navtitle>safety measure</navtitle>
                     <shortdesc>information subject. Describes safety measures for work tasks.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#SafetyMeasure"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.RestrictionOnUse">
                  <topicmeta>
                     <navtitle>restriction on use</navtitle>
                     <shortdesc>information subject that covers information specifying under which conditions or in which manner the product shall not be used</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#RestrictionOnUse"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.InstallationError">
                  <topicmeta>
                     <navtitle>installation error</navtitle>
                     <shortdesc>information subject. Describes installation errors.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#InstallationError"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.SafetyInstruction">
                  <topicmeta>
                     <navtitle>safety instruction</navtitle>
                     <shortdesc>information subject covering general safety-related information applying to a range of information units</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#SafetyInstruction"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.EnvironmentalProtectionInstruction">
                  <topicmeta>
                     <navtitle>environmental protection instruction</navtitle>
                     <shortdesc>information subject. Instructions in technical documentation for working in an environmentally compatible way.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#EnvironmentalProtectionInstruction"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirdsMch.ExplosionProtection">
                  <topicmeta>
                     <navtitle>explosion protection</navtitle>
                     <shortdesc>information subject. Information in technical documentation how to avoid explosions when working with the product.</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#ExplosionProtection"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.GenericSafety">
                  <topicmeta>
                     <navtitle>safety</navtitle>
                     <shortdesc>information subject that covers content which helps to avoid risk</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericSafety"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
               <subjectdef keys="iirds.WarningMessage">
                  <topicmeta>
                     <navtitle>warning message</navtitle>
                     <shortdesc>safety-related information that warns about hazards and instructs on how to avoid them</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#WarningMessage" appname="class-iri"/>
                  </topicmeta>
                  <subjectdef keys="iirds.Caution">
                     <topicmeta>
                        <navtitle>caution</navtitle>
                        <shortdesc>warning message that describes a hazardous situation which, if not avoided, could result in minor or moderate injury</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Caution" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.GenericWarningMessage">
                     <topicmeta>
                        <navtitle>warning message</navtitle>
                        <shortdesc>safety-related information that warns about hazards and instructs on how to avoid them</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#GenericWarningMessage"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Warning">
                     <topicmeta>
                        <navtitle>warning</navtitle>
                        <shortdesc>warning message that describes a hazardous situation which, if not avoided, could result in death or serious injury</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Warning" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Notice">
                     <topicmeta>
                        <navtitle>notice</navtitle>
                        <shortdesc>message that contains information considered important but not related to personal injury</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Notice" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Danger">
                     <topicmeta>
                        <navtitle>danger</navtitle>
                        <shortdesc>warning message that describes a hazardous situation which, if not avoided, will result in death or serious injury</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Danger" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
               </subjectdef>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.TopicType">
            <topicmeta>
               <navtitle>topic type</navtitle>
               <shortdesc>type of information determined according to functional principles</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#TopicType" appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.Concept">
               <topicmeta>
                  <navtitle>concept</navtitle>
                  <shortdesc>topic type that provides background information which helps users understand the structure or essential principles of a product, interface, or task</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Concept" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.GenericConcept">
                  <topicmeta>
                     <navtitle>concept</navtitle>
                     <shortdesc>topic type providing background information that helps users understand the structure or essential principles of a product, interface, or task</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericConcept"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.Learning">
               <topicmeta>
                  <navtitle>learning</navtitle>
                  <shortdesc>topic type that provides learning content</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Learning" appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.GenericLearning">
                  <topicmeta>
                     <navtitle>learning</navtitle>
                     <shortdesc>type of topic that provides learning content</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#GenericLearning"
                                 appname="instance-iri"/>
                  </topicmeta>
               </subjectdef>
            </subjectdef>
            <subjectdef keys="iirds.Troubleshooting">
               <topicmeta>
                  <navtitle>troubleshooting </navtitle>

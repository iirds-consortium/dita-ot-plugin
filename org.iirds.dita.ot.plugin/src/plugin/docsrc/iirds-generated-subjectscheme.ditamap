      <subjectdef keys="iirds.DocumentationMetadata">
         <topicmeta>
            <navtitle>documentation metadata</navtitle>
            <shortdesc>information that describes the context to which iiRDS resources apply</shortdesc>
            <resourceid appid="http://iirds.tekom.de/iirds#DocumentationMetadata"
                        appname="class-iri"/>
         </topicmeta>
         <subjectdef keys="iirds.ProductMetadata">
            <topicmeta>
               <navtitle>productMetadata</navtitle>
               <shortdesc>information about a product or component</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ProductMetadata" appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.ProductLifeCyclePhase">
               <topicmeta>
                  <navtitle>phase of product lifecycle</navtitle>
                  <shortdesc>defined period in the evolution of a product from the conceptual idea to its ultimate disposal</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ProductLifeCyclePhase"
                              appname="class-iri"/>
               </topicmeta>
               <subjectdef keys="iirds.AfterUse">
                  <topicmeta>
                     <navtitle>after use</navtitle>
                     <shortdesc>product life cycle phase that follows the active use of the product</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#AfterUse" appname="class-iri"/>
                  </topicmeta>
                  <subjectdef keys="iirdsMch.CloseDown">
                     <topicmeta>
                        <navtitle>close down</navtitle>
                        <shortdesc>lifecycle phase of a product in which a plant, technical system, or facility is shut down permanently.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#CloseDown"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Disassembly">
                     <topicmeta>
                        <navtitle>disassembly</navtitle>
                        <shortdesc>product lifecycle phase containing activities related to separating a machine or technical system into its different parts.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Disassembly"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.GenericAfterUse">
                     <topicmeta>
                        <navtitle>after use</navtitle>
                        <shortdesc>product life cycle phase following the active use of the product</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#GenericAfterUse"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdSft.Deinstallation">
                     <topicmeta>
                        <navtitle>deinstallation</navtitle>
                        <shortdesc>lifecycle phase of a product containing procedures for deinstalling an IT system or removing a software from a system.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/software#Deinstallation"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Disposal">
                     <topicmeta>
                        <navtitle>disposal</navtitle>
                        <shortdesc>product life cycle phase spanning the process of elimination of a product or component</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Disposal" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Storage">
                     <topicmeta>
                        <navtitle>storage</navtitle>
                        <shortdesc>lifecycle phase of a product that describes the process of keeping physical products available or in an adequate environment in order to bridge the time gap between arrival and use.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Storage"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Reuse">
                     <topicmeta>
                        <navtitle>recycling</navtitle>
                        <shortdesc>lifecycle phase after the active use of a product; contains activities for recycling and reusing machine components and materials.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Reuse"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
               </subjectdef>
               <subjectdef keys="iirds.DesignAndRealization">
                  <topicmeta>
                     <navtitle>design and realization</navtitle>
                     <shortdesc>product life cycle phase from environment analysis and ideation through production</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#DesignAndRealization"
                                 appname="class-iri"/>
                  </topicmeta>
                  <subjectdef keys="iirds.GenericDesignAndRealization">
                     <topicmeta>
                        <navtitle>design and realization</navtitle>
                        <shortdesc>product life cycle phase from ideation through production</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#GenericDesignAndRealization"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Design">
                     <topicmeta>
                        <navtitle>design</navtitle>
                        <shortdesc>product life cycle phase of designing systems, products, or services</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Design" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Construction">
                     <topicmeta>
                        <navtitle>construction</navtitle>
                        <shortdesc>product lifecycle phase containing activities for constructing a technical system.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Construction"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Acquisition">
                     <topicmeta>
                        <navtitle>acquisition</navtitle>
                        <shortdesc>product life cycle phase of obtaining systems, products, or services as part of design and realization</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Acquisition" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Development">
                     <topicmeta>
                        <navtitle>development</navtitle>
                        <shortdesc>product life cycle phase of transfoming from design into a production-ready functional system, product or service</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Development" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.RequirementsAnalysis">
                     <topicmeta>
                        <navtitle>requirement analysis</navtitle>
                        <shortdesc>product life cycle phase in which understanding and prioritisation of necessary product characteristics is achieved</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#RequirementsAnalysis"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Production">
                     <topicmeta>
                        <navtitle>production</navtitle>
                        <shortdesc>product life cycle phase of manufacturing products</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Production" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
               </subjectdef>
               <subjectdef keys="iirds.Use">
                  <topicmeta>
                     <navtitle>use</navtitle>
                     <shortdesc>product life cycle phase in which the product is supposed to realize its function</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#Use" appname="class-iri"/>
                  </topicmeta>
                  <subjectdef keys="iirdSft.Administration">
                     <topicmeta>
                        <navtitle>administration</navtitle>
                        <shortdesc>lifecycle phase of a product containing activities related to managing, updating, and configuring software products and IT systems.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/software#Administration"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Cleaning">
                     <topicmeta>
                        <navtitle>cleaning</navtitle>
                        <shortdesc>product lifecycle phase of a technical system in which unwanted substances, such as dirt, are removed from the system.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Cleaning"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdSft.Update">
                     <topicmeta>
                        <navtitle>update</navtitle>
                        <shortdesc>lifecycle phase of a software product containing procedures for installing a new version of a software in an IT system.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/software#Update"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Maintenance">
                     <topicmeta>
                        <navtitle>maintenance</navtitle>
                        <shortdesc>product life cycle phase of activities intended  to retain or restore a system in or to operational state</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Maintenance" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.GenericUse">
                     <topicmeta>
                        <navtitle>use</navtitle>
                        <shortdesc>product life cycle phase in which the product is supposed to realize its function</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#GenericUse" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Commissioning">
                     <topicmeta>
                        <navtitle>commissioning</navtitle>
                        <shortdesc>product lifecycle phase containing activities related to transferring a product into active use and instructing personnel on the use. Activities include final inspection tests and handover of documentation, among others (DIN EN 82079-1).</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Commissioning"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Operation">
                     <topicmeta>
                        <navtitle>operation</navtitle>
                        <shortdesc>product life cycle phase in which a system carries out its designated functions</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Operation" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Decommissioning">
                     <topicmeta>
                        <navtitle>decommissioning</navtitle>
                        <shortdesc>product life cycle phase of shutting down a system at the end of its usage period</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Decommissioning"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdSft.Customization">
                     <topicmeta>
                        <navtitle>customization</navtitle>
                        <shortdesc>lifecycle phase of a product containing activities relating to reworking a standard product to the special requirements of individual customers.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/software#Customization"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Modification">
                     <topicmeta>
                        <navtitle>modification</navtitle>
                        <shortdesc>lifecycle phase of a product during which it is modified.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Modification"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Repair">
                     <topicmeta>
                        <navtitle>repair</navtitle>
                        <shortdesc>product life cycle phase of rectification of damages and malfunctions</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Repair" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.EmergencyOperation">
                     <topicmeta>
                        <navtitle>emergency operation</navtitle>
                        <shortdesc>product life cycle of restricted operation of a system to protect it from damage</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#EmergencyOperation"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Fault">
                     <topicmeta>
                        <navtitle>fault</navtitle>
                        <shortdesc>product life cycle that spans the interruption of the intended operation of a system due to malfunction</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Fault" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Diagnostics">
                     <topicmeta>
                        <navtitle>diagnostics</navtitle>
                        <shortdesc>product life cycle phase of identifying a fault and its cause whitin the use phase</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Diagnostics" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
               </subjectdef>
               <subjectdef keys="iirds.PuttingToUse">
                  <topicmeta>
                     <navtitle>putting to use</navtitle>
                     <shortdesc>product life cycle phase after production in which a product is set up for its intended use</shortdesc>
                     <resourceid appid="http://iirds.tekom.de/iirds#PuttingToUse" appname="class-iri"/>
                  </topicmeta>
                  <subjectdef keys="iirds.Configuration">
                     <topicmeta>
                        <navtitle>configuration</navtitle>
                        <shortdesc>product life cycle phase of adapting settings to achieve the desired functionality of a product</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Configuration"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.Installation">
                     <topicmeta>
                        <navtitle>installation</navtitle>
                        <shortdesc>product life cycle phase of setting up a product in the designated target environment so that it fulfils its intended use</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#Installation" appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Assembly">
                     <topicmeta>
                        <navtitle>assembly</navtitle>
                        <shortdesc>lifecycle phase of a product in which the product or its components are assembled for use.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Assembly"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirds.GenericPuttingToUse">
                     <topicmeta>
                        <navtitle>putting to use</navtitle>
                        <shortdesc>product life cycle phase after production in which a product is set up for its intended use</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds#GenericPuttingToUse"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdSft.Deployment">
                     <topicmeta>
                        <navtitle>deployment</navtitle>
                        <shortdesc>lifecycle phase of a product describing activities related to making a software system available for use.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/software#Deployment"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.Transport">
                     <topicmeta>
                        <navtitle>transport</navtitle>
                        <shortdesc>lifecycle phase of a product containing activities for transporting a technical system or its components from one location to the other.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#Transport"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdsMch.FirstUse">
                     <topicmeta>
                        <navtitle>first use</navtitle>
                        <shortdesc>product lifecycle phase describing the very first operation of a machine according to its intended use.</shortdesc>
                        <resourceid appid="http://iirds.tekom.de/iirds/domain/machinery#FirstUse"
                                    appname="instance-iri"/>
                     </topicmeta>
                  </subjectdef>
                  <subjectdef keys="iirdSft.Integration">
                     <topicmeta>
                        <navtitle>integration</navtitle>
